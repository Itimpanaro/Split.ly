{
  "build": {
    "dockerfilePath": "Dockerfile"
  },
  "deploy": {
    "startCommand": "apache2-foreground",
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 3
  },
  "service": {
    "envVars": {
      "PORT": "80",
      "APP_ENV": "production",
      "APP_DEBUG": "false"
    }
  }
}
